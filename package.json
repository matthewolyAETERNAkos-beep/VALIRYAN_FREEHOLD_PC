{
  "name": "valiryan-freehold-pc",
  "version": "1.0.0",
  "description": "VALIRYAN FREEHOLD browser for Windows",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.valiryan.freehold.pc",
    "productName": "VALIRYAN FREEHOLD",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "renderer.js", "style.css", "package.json"],
    "win": { "target": ["portable"] }
  }
}
